# OpenAI Provider Configuration
# Copy this file to .env for local use.
# NEVER put a real API key in .env.example.

OPENAI_API_KEY=replace-with-your-own-key
OPENAI_MODEL=replace-with-a-model-available-to-your-account

# Optional OpenAI-compatible base URL.
# Leave blank to use the default OpenAI API endpoint.
OPENAI_BASE_URL=

# Request timeout in seconds.
OPENAI_TIMEOUT_SECONDS=30

# Number of automatic retries for temporary API/network failures.
OPENAI_MAX_RETRIES=2
